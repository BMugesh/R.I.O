# ==========================================
# R.I.O. (Reasoning Intelligence Orchestration)
# Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-in-production-super-secret-key-32chars
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers (Groq is the primary fast provider)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Routing Mode ('groq' | 'openai' | 'mock' for offline testing)
DEFAULT_MODEL_PROVIDER=groq

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://rio_user:rio_password@localhost:5432/rio_db
DATABASE_SYNC_URL=postgresql://rio_user:rio_password@localhost:5432/rio_db

# Cache & PubSub (Redis)
REDIS_URL=redis://localhost:6379/0

# Device Agent Security
RIO_DEVICE_SECRET=rio_device_secret_token_change_in_prod

# GitHub Integration
GITHUB_TOKEN=your_github_token_here

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rio-os

      "intervention_sequence": [
        { "type": "decision", "action_id": "export_report", "decision": "reject", "reason": "Verify citations first" }
      ],
      "expected_terminal_status": "rejected",
      "expected_gate_action": "export_report",
      "expected_boundary_triggered": false,
      "expected_export_approved": false,
      "expected_external_publication": false
    },

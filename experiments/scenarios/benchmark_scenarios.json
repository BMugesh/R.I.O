{
  "suite_version": "0.2.0",
  "description": "Pre-deployment verification experiments for R.I.O. public sandbox: (1) reject approval, (2) approve approval, (3) restricted access probes (filesystem/shell/credentials/email), and (4) repeat-task reproducibility.",
  "scenarios": [
